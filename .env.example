; =============================================================
; 统一管理平台 · 环境变量示例
; 用法：复制为 .env 后按服务器实际情况填写；.env 禁止提交仓库
; =============================================================
APP_DEBUG = false
APP_TRACE = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
CORS_ORIGINS =

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = authpro_platform
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX =
DEBUG = false

[JWT]
SECRET =
TTL = 7200
ISSUER = authpro-platform
