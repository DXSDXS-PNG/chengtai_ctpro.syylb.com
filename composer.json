{
  "name": "nextgen/platform",
  "description": "统一管理平台 - 插件底座后端（ThinkPHP 8）",
  "type": "project",
  "keywords": ["thinkphp", "platform", "plugin"],
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "topthink/framework": "^8.0",
    "topthink/think-orm": "^3.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app"
    },
    "files": [],
    "classmap": ["extend"]
  },
  "autoload-dev": {
    "psr-4": {},
    "files": []
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {}
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
